# Copy to .env (or set in your hosting dashboard). Everything is optional in development.
PORT=4000
PUBLIC_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string    # required when NODE_ENV=production
DB_PATH=data/dr-nath.db
UPLOAD_DIR=data/uploads
ISSUER_KEY_PATH=data/issuer-key.json             # Ed25519 badge-signing key: keep secret, back it up
FEEDBACK_SLA_DAYS=5
ANTHROPIC_API_KEY=                               # enables "Draft with AI" for mentors
SENDGRID_API_KEY=                                # email; without it emails are logged to the console
AFRICAS_TALKING_API_KEY=                         # SMS; without it SMS are logged to the console
AFRICAS_TALKING_USERNAME=sandbox
